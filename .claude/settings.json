{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__filigree__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree ensure-dashboard",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree session-context",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree ensure-dashboard",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "loomweave hook session-start --path '/home/john/simic'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/warpline session-context --repo '/home/john/simic'",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/legis session-context",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "foundryside-marketplace": {
      "source": {
        "source": "github",
        "repo": "tachyon-beep/skillpacks"
      }
    }
  },
  "enabledPlugins": {
    "axiom-audit-pipelines@foundryside-marketplace": true,
    "axiom-determinism-and-replay@foundryside-marketplace": true,
    "axiom-embedded-database@foundryside-marketplace": true,
    "axiom-engineering-foundations@foundryside-marketplace": true,
    "axiom-planning@foundryside-marketplace": true,
    "axiom-product-management@foundryside-marketplace": true,
    "axiom-program-management@foundryside-marketplace": true,
    "axiom-python-engineering@foundryside-marketplace": true,
    "axiom-static-analysis-engineering@foundryside-marketplace": true,
    "axiom-system-archaeologist@foundryside-marketplace": true,
    "lyra-tui-designer@foundryside-marketplace": true,
    "meta-sme-protocol@foundryside-marketplace": true,
    "muna-technical-writer@foundryside-marketplace": true,
    "ordis-quality-engineering@foundryside-marketplace": true,
    "yzmir-ai-engineering-expert@foundryside-marketplace": true,
    "yzmir-deep-rl@foundryside-marketplace": true,
    "yzmir-dynamic-architectures@foundryside-marketplace": true,
    "yzmir-morphogenetic-rl@foundryside-marketplace": true,
    "yzmir-neural-architectures@foundryside-marketplace": true,
    "yzmir-pytorch-engineering@foundryside-marketplace": true,
    "yzmir-systems-thinking@foundryside-marketplace": true,
    "yzmir-training-optimization@foundryside-marketplace": true
  }
}
