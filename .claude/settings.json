{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__filigree__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree ensure-dashboard",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree session-context",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "/home/john/.local/bin/filigree ensure-dashboard",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "loomweave hook session-start --path '/home/john/simic'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/warpline session-context --repo '/home/john/simic'",
            "timeout": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/john/.local/bin/legis session-context",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "superpowers@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "lyra-ux-designer@foundryside-marketplace": true,
    "lyra-site-designer@foundryside-marketplace": true,
    "axiom-devops-engineering@foundryside-marketplace": true,
    "axiom-audit-pipelines@foundryside-marketplace": true,
    "axiom-determinism-and-replay@foundryside-marketplace": true,
    "axiom-embedded-database@foundryside-marketplace": true,
    "axiom-engineering-foundations@foundryside-marketplace": true,
    "axiom-planning@foundryside-marketplace": true,
