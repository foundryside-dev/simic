{
  "theme": "base",
  "htmlLabels": false,
  "fontFamily": "Arial, Helvetica, 'Liberation Sans', sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, 'Liberation Sans', sans-serif",
    "fontSize": "15px",
    "background": "transparent",
    "primaryColor": "#ebf1f4",
    "primaryTextColor": "#06151b",
    "primaryBorderColor": "#bbc8ce",
    "mainBkg": "#ebf1f4",
    "nodeBorder": "#bbc8ce",
    "nodeTextColor": "#06151b",
    "secondaryColor": "#f7fbfc",
    "secondaryTextColor": "#06151b",
    "secondaryBorderColor": "#bbc8ce",
    "tertiaryColor": "#f7fbfc",
    "tertiaryTextColor": "#06151b",
    "tertiaryBorderColor": "#bbc8ce",
    "lineColor": "#54656c",
    "textColor": "#06151b",
    "titleColor": "#030c10",
    "arrowheadColor": "#54656c",
    "clusterBkg": "#f7fbfc",
    "clusterBorder": "#bbc8ce",
    "edgeLabelBackground": "#f7fbfc",
    "labelBackgroundColor": "#f7fbfc",
    "labelBoxBkgColor": "#ebf1f4",
    "labelBoxBorderColor": "#bbc8ce",
    "labelTextColor": "#06151b"
  },
  "flowchart": {
    "htmlLabels": false,
    "useMaxWidth": false,
    "curve": "basis",
    "padding": 14,
    "nodeSpacing": 42,
    "rankSpacing": 46,
    "diagramPadding": 8,
    "wrappingWidth": 300
  },
  "themeCSS": ".node.accent > rect, .node.accent > polygon, .node.accent > path { fill: #dceee9 !important; stroke: #006c58 !important; stroke-width: 1.6px !important; } .node.accent text, .node.accent tspan { fill: #06151b !important; } .edgeLabel rect { fill: #f7fbfc !important; } .cluster > rect { stroke-dasharray: 4 3 !important; }"
}
